{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardrail.schema.json",
  "title": "Guardrail Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "type",
    "status",
    "owner",
    "locator",
    "enforces",
    "sourceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/guardrailId"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "type": {
      "type": "string",
      "enum": [
        "REGRESSION_TEST",
        "UNIT_TEST",
        "INTEGRATION_TEST",
        "CONTRACT_TEST",
        "E2E_TEST",
        "SKILL_GRAPH_VERIFIER",
        "ESLINT_RULE",
        "SEMGREP_RULE",
        "ARCHITECTURE_RULE",
        "RUNTIME_ALERT",
        "MANUAL_CONTROL"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "ACTIVE", "DISABLED", "SUPERSEDED"]
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "path", "ruleId"],
      "properties": {
        "project": {
          "$ref": "common.schema.json#/$defs/projectKey"
        },
        "path": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "ruleId": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "enforces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/invariantId"
      }
    },
    "sourceRefs": {
      "$ref": "common.schema.json#/$defs/sourceRefs"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "anyOf": [
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  }
                }
              },
              {
                "type": "object",
                "required": ["ruleId"],
                "properties": {
                  "ruleId": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
