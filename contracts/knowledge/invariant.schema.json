{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invariant.schema.json",
  "title": "Invariant Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "statement",
    "rationale",
    "severity",
    "status",
    "owner",
    "appliesTo",
    "sourceRefs",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/invariantId"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "statement": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "rationale": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "ACTIVE", "DEPRECATED"]
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "pathGlobs", "codeUnitKinds"],
      "properties": {
        "projects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/projectKey"
          }
        },
        "pathGlobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        },
        "codeUnitKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/codeUnitKind"
          }
        }
      }
    },
    "sourceRefs": {
      "$ref": "common.schema.json#/$defs/sourceRefs"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/invariantId"
      }
    }
  }
}
